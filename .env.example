# Copiar a .env (no se sube a git). No colocar valores reales aquí.

# App
SECRET_KEY=
ADMIN_PASS=
# Opcional: contraseña inicial de los usuarios de usuarios_iniciales.py (si no, usa la del archivo)
SEED_USER_PASSWORD=
PQR_URL_BASE=http://localhost:8000

# PostgreSQL (en docker compose PGHOST/PORT los fija compose; en Render use su base externa,
# p. ej. Supabase o Neon — copie el connection string que dan y use PGSSLMODE=require)
PGHOST=
PGPORT=5432
PGUSER=pqr
PGPASSWORD=
PGDATABASE=sistema_pqr
PGSSLMODE=prefer

# Correo (Gmail requiere "Contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
