# Copiar a .env (no se sube a git). No colocar valores reales aquí.

# App
SECRET_KEY=
ADMIN_PASS=
PQR_URL_BASE=http://localhost:8000

# MySQL (en docker compose MYSQL_HOST/PORT los fija compose; en Render use su base externa)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=pqr
MYSQL_PASSWORD=
MYSQL_DATABASE=sistema_pqr
MYSQL_ROOT_PASSWORD=

# Correo (Gmail requiere "Contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
