# Copiar a .env (no se sube a git). No colocar valores reales aquí.

# App
SECRET_KEY=
ADMIN_PASS=
# Opcional: contraseña inicial de los usuarios de usuarios_iniciales.py (si no, usa la del archivo)
SEED_USER_PASSWORD=
PQR_URL_BASE=http://localhost:8000

# PostgreSQL (en docker compose PGHOST/PORT los fija compose; en Render use su base externa,
# p. ej. Supabase o Neon — copie el connection string que dan y use PGSSLMODE=require)
PGHOST=
PGPORT=5432
PGUSER=pqr
PGPASSWORD=
PGDATABASE=sistema_pqr
PGSSLMODE=prefer

# Correo: en Render (cualquier plan) los puertos SMTP salientes están bloqueados,
# use la API de Brevo (gratis, https://app.brevo.com -> SMTP & API -> API Keys).
# BREVO_API_KEY tiene prioridad sobre SMTP si ambas están presentes.
BREVO_API_KEY=
SMTP_FROM=

# SMTP (solo funciona en local/Docker; Gmail requiere "Contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Evidencias: sin estas variables se guardan en disco local (se pierden en cada
# deploy de Render sin disco pago). Supabase Storage -> Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidencias
